<section id="top" class="hero">
	<div class="wrap hero-inner">
		<p class="eyebrow">Nuevos y sellados</p>
		<h1>AirPods Pro. <br /> Directo, sin vueltas.</h1>
		<p class="subhead">
			Pro 2, Pro 3 y Pro 4 disponibles ahora. Elige el tuyo, arma tu pedido y
			confírmalo por WhatsApp en un par de minutos.
		</p>
		<a href="#productos" class="btn btn-primary">Ver productos</a>
	</div>
</section>

<style>
	.hero {
		padding-top: 100px;
		padding-bottom: 80px;
		text-align: center;
	}

	.hero-inner {
		max-width: 640px;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 3.8rem);
		margin-bottom: 24px;
	}

	.subhead {
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-bottom: 32px;
	}
</style>
