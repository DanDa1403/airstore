---
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap footer-inner">
		<span class="logo">AirStore</span>
		<p>© {year} AirStore. Todos los derechos reservados.</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 28px 0;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
	}

	.logo {
		font-weight: 700;
		font-size: 1rem;
	}

	.footer-inner p {
		color: var(--text-muted);
		font-size: 0.85rem;
	}
</style>
